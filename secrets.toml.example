# Streamlit Cloud ke liye Secrets template.
# YE FILE REPO ME MAT DAALO aur isme asli password mat likho.
# Streamlit Cloud website par: App -> (three dots) -> Settings -> Secrets
# me neeche wala text paste karo, aur asli values bharo.
# Secrets repo me nahi jaate, sirf Cloud app ko milte hain.
# Username/Password: HiveMQ Cloud console -> Access Management -> MQTT Credentials
# (HiveMQ website ka login password NAHI).
HIVEMQ_HOST = "YOUR_CLUSTER.s1.eu.hivemq.cloud"
HIVEMQ_PORT = "8883"
HIVEMQ_USERNAME = "your-mqtt-username"
HIVEMQ_PASSWORD = "your-mqtt-password"
MQTT_TOPIC = "compressor/sensor"
