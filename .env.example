# Copy this file to ".env" and fill your REAL values.
# NEVER commit the real .env to GitHub.
# Host: HiveMQ Cloud console -> cluster "keenbee" -> Overview/Settings me milega.
# Username/Password: HiveMQ Cloud console -> Access Management -> MQTT Credentials
#   (ye cluster ke admin password se ALAG hote hain - wahi sabse common galti hai)
HIVEMQ_HOST=YOUR_CLUSTER.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=your-mqtt-username
HIVEMQ_PASSWORD=your-mqtt-password
MQTT_TOPIC=compressor/sensor
